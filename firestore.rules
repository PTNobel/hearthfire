rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidGame(data) {
      return data.name is string
        && data.createdAt is number
        && data.characters is list
        && data.characters.size() <= 20;
    }

    function isAllowedSession(id) {
      // This template denies access until the deploy script substitutes the
      // shared session ID. Never commit the generated rules file.
      return false; // HEARTHFIRE_SESSION_ID
    }

    match /games/{id} {
      allow get: if isAllowedSession(id);
      allow list, delete: if false;
      allow create, update: if isAllowedSession(id) && isValidGame(request.resource.data);
    }
  }
}
